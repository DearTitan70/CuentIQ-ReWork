generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Moneda {
  COP
  USD
}

enum TipoCuenta {
  BANCARIA  @map("bancaria")
  BILLETERA @map("billetera")
}

enum TipoTransaccion {
  INGRESO @map("ingreso")
  GASTO   @map("gasto")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  monedaBase   Moneda   @default(COP) @map("moneda_base")
  planId       String   @map("plan_id") @db.Uuid
  plan         Plan     @relation(fields: [planId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  cuentas      Cuenta[]
  transacciones Transaccion[]

  @@index([planId])
  @@map("usuarios")
}

model Plan {
  id                         String    @id @default(uuid()) @db.Uuid
  codigo                     String    @unique
  nombre                     String
  limiteCuentas              Int       @map("limite_cuentas")
  limiteTransaccionesMes     Int       @map("limite_transacciones_mes")
  limiteCreditos             Int       @map("limite_creditos")
  limiteConsultasIaMes       Int       @map("limite_consultas_ia_mes")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  usuarios                   Usuario[]

  @@map("planes")
}

model Cuenta {
  usuarioId    String     @map("usuario_id") @db.Uuid
  id           Int
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombre       String
  tipo         TipoCuenta
  moneda       Moneda
  saldoInicial Decimal    @map("saldo_inicial") @db.Decimal(14, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  transacciones Transaccion[]

  @@id([usuarioId, id])
  @@index([usuarioId])
  @@map("cuentas")
}

model Transaccion {
  id        String          @id @default(uuid()) @db.Uuid
  usuarioId String          @map("usuario_id") @db.Uuid
  cuentaId  Int             @map("cuenta_id")
  tipo      TipoTransaccion
  monto     Decimal         @db.Decimal(14, 2)
  createdAt DateTime        @default(now()) @map("created_at")
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cuenta    Cuenta          @relation(fields: [usuarioId, cuentaId], references: [usuarioId, id], onDelete: Restrict)

  @@index([usuarioId, cuentaId])
  @@map("transacciones")
}
